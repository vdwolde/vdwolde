{
  "about": {
    "name": "vdWolde Brand Guide",
    "version": "1.1",
    "date": "2026-11-07",
    "guide_pdf": "Brand Guide - V1.1.pdf",
    "summary": "One visual language for every vdWolde app, tool and site: graphite surfaces, one signal colour per app and a soft light rising from a lit bottom edge. Every app comes in Dark Mode and Light Mode.",
    "for_agents": [
      "Use the values in this file; do not sample colours from images.",
      "Every path is relative to the Branding folder.",
      "Pick an app's colours from apps[].signal and colour.signals; never mix two signals on one screen.",
      "Check new colour pairs against colour.contrast: 4.5:1 for text, 3:1 for rings and strokes.",
      "Copy icons from icons/<slug>/; never redraw or crop them. Use the squircle or circle master for those shapes.",
      "Write UI text by the writing rules: Title Case for names and titles, sentence case for everything else."
    ],
    "versioning": "Small edits raise the second number (1.0 to 1.1); bigger edits raise the first number (1.x to 2.0)."
  },
  "principles": [
    {
      "title": "Graphite Does the Work",
      "rule": "Surfaces are graphite in Dark Mode and off-white in Light Mode. Cards use the icon tile colour, #15171C."
    },
    {
      "title": "One Signal per App",
      "rule": "Each app uses its icon colour, and only where it matters: the primary action, the active state and the focus ring."
    },
    {
      "title": "One Backlight per View",
      "rule": "A soft glow in the signal colour rises from the bottom of the window, and the edge itself lights up, just like on the icons. Never on cards, never stacked, never animated."
    },
    {
      "title": "Hairline Edges",
      "rule": "Edges are a single pixel, like the icon rim. Raised surfaces get lighter instead of casting a shadow."
    },
    {
      "title": "Line Icons",
      "rule": "A 24 px grid, 1.75 stroke, round caps and joins. Lucide on the web, Segoe Fluent in WPF."
    },
    {
      "title": "Font Type",
      "rule": "Sora for names and numbers, DM Sans for everything else, on every platform. Labels are small DM Sans capitals. Code uses the system monospace."
    }
  ],
