  "writing": [
    {
      "topic": "Capitals",
      "rule": "Title Case for names and titles: apps, screens and sections. Sentence case for everything else: buttons, labels and messages.",
      "do": "Windows Optimizer · Apply 3 changes",
      "dont": "Apply 3 Changes"
    },
    {
      "topic": "Language",
      "rule": "One language per app. Dutch for apps made for Dutch users, like Finance Dashboard. English everywhere else, in UK spelling.",
      "do": "Overzicht · Colour · Centre",
      "dont": "Overview next to Belasting"
    },
    {
      "topic": "Buttons",
      "rule": "Start with a verb and say what will happen. Add the number when it helps people know what they are agreeing to.",
      "do": "Apply 3 changes · Close it",
      "dont": "OK · Submit"
    },
    {
      "topic": "Tone",
      "rule": "Calm, plain and direct. Say what happens next and whether it can be undone. No exclamation marks, no jargon.",
      "do": "Every change can be undone one by one.",
      "dont": "Oops! Something went wrong!"
    },
    {
      "topic": "Numbers",
      "rule": "Follow the app's language and set figures that must line up in Sora, which has tabular figures (DM Sans has none). A space between the euro sign and the amount in Dutch; a negative amount starts with a hyphen: -€ 3,00.",
      "do": "€ 1.240,50 · -€ 3,00 · €1,240.50",
      "dont": "1240.5 EUR"
    },
    {
      "topic": "Credit",
      "rule": "Every app is signed \"By vdWolde\", in the footer or the menu, linked to vdwolde.com. Below 24 px, the credit is text only.",
      "do": "By vdWolde",
      "dont": "Made with a heart by vdWolde"
    }
  ],
