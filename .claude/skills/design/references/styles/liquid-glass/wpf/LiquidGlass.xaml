<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:lg="clr-namespace:LiquidGlass">
    <!--
      Liquid Glass for WPF (opt-in house style, not the vdWolde brand). Tokens come from tokens.json (light + the dark variant's one-hue set).
      Needs SquircleBorder.cs and GlassParts.cs (namespace LiquidGlass) in the same project.
      Merge in App.xaml:  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/LiquidGlass.xaml"/></...>
      Verified 2026-10 on .NET 8 WPF (see anywhere.md 3.7).
    -->

    <!-- ===== Colour tokens (tokens.json color.light / color.dark) ===== -->
    <Color x:Key="LgInkColor">#121214</Color>
    <Color x:Key="LgInkSecondaryColor">#43434A</Color>
    <Color x:Key="LgInkTertiaryColor">#64646C</Color>
    <Color x:Key="LgOnInkColor">#FFFFFF</Color>
    <Color x:Key="LgHairlineColor">#B4B4BA</Color>
    <Color x:Key="LgControlEdgeColor">#7A7A82</Color>
    <Color x:Key="LgLimeColor">#DFF30F</Color>
    <SolidColorBrush x:Key="LgGround" Color="#F2F1F1"/>
    <SolidColorBrush x:Key="LgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LgCardSunk" Color="#E7E7EA"/>
    <SolidColorBrush x:Key="LgInk" Color="{StaticResource LgInkColor}"/>
    <SolidColorBrush x:Key="LgInkSecondary" Color="{StaticResource LgInkSecondaryColor}"/>
    <SolidColorBrush x:Key="LgInkTertiary" Color="{StaticResource LgInkTertiaryColor}"/>
    <SolidColorBrush x:Key="LgOnInk" Color="{StaticResource LgOnInkColor}"/>
    <SolidColorBrush x:Key="LgHairline" Color="{StaticResource LgHairlineColor}"/>
    <SolidColorBrush x:Key="LgControlEdge" Color="{StaticResource LgControlEdgeColor}"/>
    <SolidColorBrush x:Key="LgLime" Color="{StaticResource LgLimeColor}"/>
    <SolidColorBrush x:Key="LgFocusRing" Color="#121214"/>
    <SolidColorBrush x:Key="LgFocusHalo" Color="#FFFFFF"/>

    <!-- dark variant (one hue: glow) -->
    <SolidColorBrush x:Key="LgDarkGround" Color="#121212"/>
    <SolidColorBrush x:Key="LgDarkPanel" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="LgDarkPanelRaised" Color="#242424"/>
    <SolidColorBrush x:Key="LgDarkInk" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="LgDarkInkSecondary" Color="#B8B8C0"/>
    <SolidColorBrush x:Key="LgDarkInkTertiary" Color="#9C9CA4"/>
    <SolidColorBrush x:Key="LgDarkHairline" Color="#46464B"/>
    <Color x:Key="LgGlowColor">#5FE070</Color>
    <Color x:Key="LgGlowMidColor">#3DAB43</Color>
    <Color x:Key="LgGlowDeepColor">#003A0A</Color>
    <Color x:Key="LgGlowHotColor">#16D015</Color>
    <SolidColorBrush x:Key="LgGlow" Color="{StaticResource LgGlowColor}"/>

    <!-- ===== Shared alpha layers (tokens.json alpha.*) ===== -->
    <SolidColorBrush x:Key="LgFrostDecor" Color="#38FFFFFF"/>   <!-- alpha.frostDecor 0.22 -->
    <SolidColorBrush x:Key="LgFrostStrong" Color="#B8FFFFFF"/>  <!-- alpha.frostText 0.72, any backdrop -->
    <!-- tinted text plate: grounds.pink.tint mixed 55/45 with white, laid at alpha.frostTint 0.46 (0x75) -->
    <SolidColorBrush x:Key="LgFrostTintPink" Color="#75FCEBF1"/>
    <SolidColorBrush x:Key="LgFrostTintMint" Color="#75EBF4EF"/>
    <SolidColorBrush x:Key="LgFrostTintCream" Color="#75F9F3E8"/>
    <SolidColorBrush x:Key="LgFrostTintSky" Color="#75E9F1F9"/>
    <!-- rim: white 0.60 at the lit top-left, 0.25 at 45% of the diagonal, 0.50 at the lip end -->
    <LinearGradientBrush x:Key="LgRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99FFFFFF" Offset="0"/>
        <GradientStop Color="#40FFFFFF" Offset="0.45"/>
        <GradientStop Color="#80FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- lower-edge lip (alpha.lip 0.5), fading upward -->
    <LinearGradientBrush x:Key="LgLipBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#80FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- top sheen (white 0.16 fading out by 38% of the height) -->
    <LinearGradientBrush x:Key="LgSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#29FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.38"/>
    </LinearGradientBrush>
    <!-- gel: 1 px ring white 0.55 to 0.15, highlight white 0.16 at 20%/15%, lip 0.30 -->
    <LinearGradientBrush x:Key="LgGelRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8CFFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LgGelHighlight" Center="0.2,0.15" GradientOrigin="0.2,0.15" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#29FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="LgGelLip" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#4DFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- dark slab rim: far corner white 0.18, glow-facing bottom-right glow 0.85 (alpha.darkRimUnlit / darkRimLit) -->
    <LinearGradientBrush x:Key="LgDarkRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#4D5FE070" Offset="0.38"/>
        <GradientStop Color="#D95FE070" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Geometry: absolute radii from the 144 px module (radius.cardRatio 0.22, gelRatio 0.30) =====
         WPF CornerRadius is circular. These doubles feed SquircleBorder.Radius; the CornerRadius twins are for plain Borders (pills). -->
    <sys:Double x:Key="LgRadiusCardPx">32</sys:Double>
    <sys:Double x:Key="LgRadiusGelPx">43</sys:Double>
    <CornerRadius x:Key="LgRadiusCard">32</CornerRadius>
    <CornerRadius x:Key="LgRadiusPill">22</CornerRadius>

    <!-- ===== Type ===== -->
    <FontFamily x:Key="LgFontSans">Urbanist, Outfit, Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
    <Style x:Key="LgText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LgFontSans}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="LgLabel" TargetType="TextBlock" BasedOn="{StaticResource LgText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInkSecondary}"/>
    </Style>
    <Style x:Key="LgTitle" TargetType="TextBlock" BasedOn="{StaticResource LgText}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>
    <Style x:Key="LgDisplay" TargetType="TextBlock" BasedOn="{StaticResource LgText}">
        <Setter Property="FontSize" Value="56"/>
        <Setter Property="FontWeight" Value="Light"/>
    </Style>

    <!-- ===== Icons (24 box, drawn with a 1.5 px stroke) ===== -->
    <Geometry x:Key="LgIconSearch">M10.5 3 A7.5 7.5 0 1 0 10.5 18 A7.5 7.5 0 1 0 10.5 3 Z M16.2 16.2 L21 21</Geometry>
    <Geometry x:Key="LgIconBell">M6 16 V11 A6 6 0 0 1 18 11 V16 L20 18.5 H4 L6 16 Z M10 21 H14</Geometry>
    <Geometry x:Key="LgIconUser">M12 12 A4 4 0 1 0 12 4 A4 4 0 1 0 12 12 Z M4.5 21 C4.5 16.5 8 15 12 15 C16 15 19.5 16.5 19.5 21</Geometry>
    <Geometry x:Key="LgIconArrowNE">M7 17 L17 7 M9 7 H17 V15</Geometry>
    <Geometry x:Key="LgIconCheck">M5 12.5 L10 17.5 L19 7</Geometry>
    <Geometry x:Key="LgIconPlus">M12 5 V19 M5 12 H19</Geometry>
    <Style x:Key="LgGlyph" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}, FallbackValue=#121214}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- ===== Focus visual (SPEC 10: 2 px gap, 2 px ring, 2 px halo). FocusVisualStyle shows on keyboard focus only = :focus-visible ===== -->
    <Style x:Key="LgFocusPill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid IsHitTestVisible="False">
                        <Rectangle Margin="-5" RadiusX="27" RadiusY="27" Stroke="{DynamicResource LgFocusHalo}" StrokeThickness="2"/>
                        <Rectangle Margin="-3" RadiusX="25" RadiusY="25" Stroke="{DynamicResource LgFocusRing}" StrokeThickness="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LgFocusCircle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid IsHitTestVisible="False">
                        <Ellipse Margin="-5" Stroke="{DynamicResource LgFocusHalo}" StrokeThickness="2"/>
                        <Ellipse Margin="-3" Stroke="{DynamicResource LgFocusRing}" StrokeThickness="2"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Gel colourways (tokens.json gel.vivid.*): base linear + bottom-weighted bloom + pale edge wash ===== -->
        <Color x:Key="GelGreenTop">#C2D69B</Color><Color x:Key="GelGreenMid">#5BAB4B</Color><Color x:Key="GelGreenCore">#3B943C</Color><Color x:Key="GelGreenBottom">#8FCF9A</Color><Color x:Key="GelGreenRim">#BFE3C0</Color>
    <!-- fade stops reuse the colour with alpha 0: WPF interpolates gradients without premultiplying, so fading to #00000000 would grey the bloom -->
    <Color x:Key="GelGreenMidClear">#005BAB4B</Color><Color x:Key="GelGreenRimClear">#00BFE3C0</Color><Color x:Key="GelGreenRimWash">#99BFE3C0</Color>
    <LinearGradientBrush x:Key="GelGreenBase" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="{StaticResource GelGreenTop}" Offset="0"/><GradientStop Color="{StaticResource GelGreenBottom}" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="GelGreenBloom" Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.9" RadiusY="0.75"><GradientStop Color="{StaticResource GelGreenCore}" Offset="0"/><GradientStop Color="{StaticResource GelGreenMid}" Offset="0.5"/><GradientStop Color="{StaticResource GelGreenMidClear}" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GelGreenWash" Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.82" RadiusY="0.78"><GradientStop Color="{StaticResource GelGreenRimClear}" Offset="0"/><GradientStop Color="{StaticResource GelGreenRimClear}" Offset="0.5"/><GradientStop Color="{StaticResource GelGreenRimWash}" Offset="1"/></RadialGradientBrush>
    <Color x:Key="GelPinkTop">#F9B3CD</Color><Color x:Key="GelPinkMid">#F99BBC</Color><Color x:Key="GelPinkCore">#F36393</Color><Color x:Key="GelPinkBottom">#F53B8A</Color><Color x:Key="GelPinkRim">#FBD9E5</Color>
    <!-- fade stops reuse the colour with alpha 0: WPF interpolates gradients without premultiplying, so fading to #00000000 would grey the bloom -->
    <Color x:Key="GelPinkMidClear">#00F99BBC</Color><Color x:Key="GelPinkRimClear">#00FBD9E5</Color><Color x:Key="GelPinkRimWash">#99FBD9E5</Color>
    <LinearGradientBrush x:Key="GelPinkBase" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="{StaticResource GelPinkTop}" Offset="0"/><GradientStop Color="{StaticResource GelPinkBottom}" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="GelPinkBloom" Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.9" RadiusY="0.75"><GradientStop Color="{StaticResource GelPinkCore}" Offset="0"/><GradientStop Color="{StaticResource GelPinkMid}" Offset="0.5"/><GradientStop Color="{StaticResource GelPinkMidClear}" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GelPinkWash" Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.82" RadiusY="0.78"><GradientStop Color="{StaticResource GelPinkRimClear}" Offset="0"/><GradientStop Color="{StaticResource GelPinkRimClear}" Offset="0.5"/><GradientStop Color="{StaticResource GelPinkRimWash}" Offset="1"/></RadialGradientBrush>
    <Color x:Key="GelBlueTop">#53B4E3</Color><Color x:Key="GelBlueMid">#4194ED</Color><Color x:Key="GelBlueCore">#327CF3</Color><Color x:Key="GelBlueBottom">#53B4E3</Color><Color x:Key="GelBlueRim">#8FD0F0</Color>
    <!-- fade stops reuse the colour with alpha 0: WPF interpolates gradients without premultiplying, so fading to #00000000 would grey the bloom -->
    <Color x:Key="GelBlueMidClear">#004194ED</Color><Color x:Key="GelBlueRimClear">#008FD0F0</Color><Color x:Key="GelBlueRimWash">#998FD0F0</Color>
    <LinearGradientBrush x:Key="GelBlueBase" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="{StaticResource GelBlueTop}" Offset="0"/><GradientStop Color="{StaticResource GelBlueBottom}" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="GelBlueBloom" Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.9" RadiusY="0.75"><GradientStop Color="{StaticResource GelBlueCore}" Offset="0"/><GradientStop Color="{StaticResource GelBlueMid}" Offset="0.5"/><GradientStop Color="{StaticResource GelBlueMidClear}" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GelBlueWash" Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.82" RadiusY="0.78"><GradientStop Color="{StaticResource GelBlueRimClear}" Offset="0"/><GradientStop Color="{StaticResource GelBlueRimClear}" Offset="0.5"/><GradientStop Color="{StaticResource GelBlueRimWash}" Offset="1"/></RadialGradientBrush>
    <Color x:Key="GelOrangeTop">#FCE9CC</Color><Color x:Key="GelOrangeMid">#FDC395</Color><Color x:Key="GelOrangeCore">#E94CC2</Color><Color x:Key="GelOrangeBottom">#F6713B</Color><Color x:Key="GelOrangeRim">#F7C6EA</Color>
    <!-- fade stops reuse the colour with alpha 0: WPF interpolates gradients without premultiplying, so fading to #00000000 would grey the bloom -->
    <Color x:Key="GelOrangeMidClear">#00FDC395</Color><Color x:Key="GelOrangeRimClear">#00F7C6EA</Color><Color x:Key="GelOrangeRimWash">#99F7C6EA</Color>
    <LinearGradientBrush x:Key="GelOrangeBase" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="{StaticResource GelOrangeTop}" Offset="0"/><GradientStop Color="{StaticResource GelOrangeBottom}" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="GelOrangeBloom" Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.9" RadiusY="0.75"><GradientStop Color="{StaticResource GelOrangeCore}" Offset="0"/><GradientStop Color="{StaticResource GelOrangeMid}" Offset="0.5"/><GradientStop Color="{StaticResource GelOrangeMidClear}" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GelOrangeWash" Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.82" RadiusY="0.78"><GradientStop Color="{StaticResource GelOrangeRimClear}" Offset="0"/><GradientStop Color="{StaticResource GelOrangeRimClear}" Offset="0.5"/><GradientStop Color="{StaticResource GelOrangeRimWash}" Offset="1"/></RadialGradientBrush>
    <Color x:Key="GelVioletTop">#CB7EDC</Color><Color x:Key="GelVioletMid">#B86DD3</Color><Color x:Key="GelVioletCore">#AD62D3</Color><Color x:Key="GelVioletBottom">#CB7EDC</Color><Color x:Key="GelVioletRim">#D4A0F0</Color>
    <!-- fade stops reuse the colour with alpha 0: WPF interpolates gradients without premultiplying, so fading to #00000000 would grey the bloom -->
    <Color x:Key="GelVioletMidClear">#00B86DD3</Color><Color x:Key="GelVioletRimClear">#00D4A0F0</Color><Color x:Key="GelVioletRimWash">#99D4A0F0</Color>
    <LinearGradientBrush x:Key="GelVioletBase" StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="{StaticResource GelVioletTop}" Offset="0"/><GradientStop Color="{StaticResource GelVioletBottom}" Offset="1"/></LinearGradientBrush>
    <RadialGradientBrush x:Key="GelVioletBloom" Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.9" RadiusY="0.75"><GradientStop Color="{StaticResource GelVioletCore}" Offset="0"/><GradientStop Color="{StaticResource GelVioletMid}" Offset="0.5"/><GradientStop Color="{StaticResource GelVioletMidClear}" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="GelVioletWash" Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.82" RadiusY="0.78"><GradientStop Color="{StaticResource GelVioletRimClear}" Offset="0"/><GradientStop Color="{StaticResource GelVioletRimClear}" Offset="0.5"/><GradientStop Color="{StaticResource GelVioletRimWash}" Offset="1"/></RadialGradientBrush>

    <!-- ===== Surface 1: matte card (shadow sibling + hairline; no blur, no rim) ===== -->
    <Style x:Key="LgMatteCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="22"/>
        <Setter Property="lg:Glass.Radius" Value="{StaticResource LgRadiusCardPx}"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- shadow lives on a fill-only sibling: an Effect on the card would re-rasterise its text -->
                        <lg:SquircleBorder Radius="{Binding Path=(lg:Glass.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="#FFFFFF">
                            <lg:SquircleBorder.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.07" Direction="270" ShadowDepth="2" BlurRadius="14"/>
                            </lg:SquircleBorder.Effect>
                        </lg:SquircleBorder>
                        <lg:SquircleBorder Radius="{Binding Path=(lg:Glass.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource LgCard}"
                                           BorderBrush="{DynamicResource LgHairline}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </lg:SquircleBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Surface 2: frost plate (faux backdrop blur of the sibling ground). Set lg:Glass.Ground to the ground element. ===== -->
    <Style x:Key="LgFrostPlate" TargetType="ContentControl">
        <Setter Property="Padding" Value="22"/>
        <Setter Property="lg:Glass.Radius" Value="{StaticResource LgRadiusCardPx}"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="lg:Glass.Tint" Value="{StaticResource LgFrostDecor}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <lg:SquircleBorder Radius="{Binding Path=(lg:Glass.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent"
                                       BorderBrush="{StaticResource LgRimBrush}" BorderThickness="1.5">
                        <Grid>
                            <!-- bleed of 3 sigma (sigma = Radius / 3, so bleed = Radius) keeps the blurred edge solid; the squircle clip trims it -->
                            <lg:FrostBackdrop Margin="-48" Source="{Binding Path=(lg:Glass.Ground), RelativeSource={RelativeSource TemplatedParent}}">
                                <lg:FrostBackdrop.Effect>
                                    <BlurEffect Radius="45" KernelType="Gaussian" RenderingBias="Quality"/>
                                </lg:FrostBackdrop.Effect>
                            </lg:FrostBackdrop>
                            <Rectangle Fill="{Binding Path=(lg:Glass.Tint), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Rectangle Fill="{StaticResource LgSheenBrush}"/>
                            <Rectangle Height="9" VerticalAlignment="Bottom" Fill="{StaticResource LgLipBrush}"/>
                            <lg:GrainOverlay Opacity="0.35"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </lg:SquircleBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LgFrostPlateText" TargetType="ContentControl" BasedOn="{StaticResource LgFrostPlate}">
        <Setter Property="lg:Glass.Tint" Value="{StaticResource LgFrostTintPink}"/>
    </Style>

    <!-- ===== Surface 3: gel tile (ink text on vivid ramps) ===== -->
    <Style x:Key="LgGel" TargetType="ContentControl">
        <Setter Property="Padding" Value="22"/>
        <Setter Property="lg:Glass.Radius" Value="{StaticResource LgRadiusGelPx}"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <lg:SquircleBorder Radius="{Binding Path=(lg:Glass.Radius), RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}"
                                       >
                        <Grid>
                            <Rectangle Fill="{Binding Path=(lg:Glass.Bloom), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Rectangle Fill="{Binding Path=(lg:Glass.Wash), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Rectangle Fill="{StaticResource LgGelHighlight}"/>
                            <Rectangle Height="10" VerticalAlignment="Bottom" Fill="{StaticResource LgGelLip}"/>
                            <lg:GrainOverlay Opacity="0.35"/>
                            <!-- the 1 px ring sits on top of the pale wash, not over the saturated base: a border drawn by the parent would be under the clipped content -->
                            <lg:SquircleBorder Radius="{Binding Path=(lg:Glass.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                                               BorderBrush="{StaticResource LgGelRimBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </lg:SquircleBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        <Style x:Key="LgGelGreen" TargetType="ContentControl" BasedOn="{StaticResource LgGel}"><Setter Property="Background" Value="{StaticResource GelGreenBase}"/><Setter Property="lg:Glass.Bloom" Value="{StaticResource GelGreenBloom}"/><Setter Property="lg:Glass.Wash" Value="{StaticResource GelGreenWash}"/></Style>
    <Style x:Key="LgGelPink" TargetType="ContentControl" BasedOn="{StaticResource LgGel}"><Setter Property="Background" Value="{StaticResource GelPinkBase}"/><Setter Property="lg:Glass.Bloom" Value="{StaticResource GelPinkBloom}"/><Setter Property="lg:Glass.Wash" Value="{StaticResource GelPinkWash}"/></Style>
    <Style x:Key="LgGelBlue" TargetType="ContentControl" BasedOn="{StaticResource LgGel}"><Setter Property="Background" Value="{StaticResource GelBlueBase}"/><Setter Property="lg:Glass.Bloom" Value="{StaticResource GelBlueBloom}"/><Setter Property="lg:Glass.Wash" Value="{StaticResource GelBlueWash}"/></Style>
    <Style x:Key="LgGelOrange" TargetType="ContentControl" BasedOn="{StaticResource LgGel}"><Setter Property="Background" Value="{StaticResource GelOrangeBase}"/><Setter Property="lg:Glass.Bloom" Value="{StaticResource GelOrangeBloom}"/><Setter Property="lg:Glass.Wash" Value="{StaticResource GelOrangeWash}"/></Style>
    <Style x:Key="LgGelViolet" TargetType="ContentControl" BasedOn="{StaticResource LgGel}"><Setter Property="Background" Value="{StaticResource GelVioletBase}"/><Setter Property="lg:Glass.Bloom" Value="{StaticResource GelVioletBloom}"/><Setter Property="lg:Glass.Wash" Value="{StaticResource GelVioletWash}"/></Style>

    <!-- ===== Controls ===== -->
    <!-- Pill tab: stadium, 1.5 px control-edge, min height 44; checked = inverted ink pill + check mark (never colour alone).
         Works on ToggleButton and RadioButton. Hover lifts 2 px (spring "settle"), press scales 0.97 (spring "press"). -->
    <Style x:Key="LgPillTab" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource LgFontSans}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LgFocusPill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="Lift" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="Pill" CornerRadius="22" MinHeight="44" Background="{DynamicResource LgCard}"
                                BorderBrush="{DynamicResource LgControlEdge}" BorderThickness="1.5" Padding="20,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="Check" Data="{StaticResource LgIconCheck}" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource LgOnInk}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource LgInk}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource LgInk}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource LgOnInk}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.463">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="260" Friction="30" SettleMs="463"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.463">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="260" Friction="30" SettleMs="463"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass icon button: 44 px circle, white 0.24 fill, 1 px hairline lens rim, 1.5 px ink glyph. -->
    <Style x:Key="LgGlassIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{DynamicResource LgInk}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LgFocusCircle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="Lift" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Ellipse Fill="#3DFFFFFF" Stroke="{DynamicResource LgHairline}" StrokeThickness="1"/>
                        <!-- lens crescent (lilac / peach / blue, tokens color.lens), bottom-left and top-right -->
                        <Ellipse Margin="1" StrokeThickness="1.2">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="#C9B6EE" Offset="0"/>
                                    <GradientStop Color="#00F3D4C3" Offset="0.28"/>
                                    <GradientStop Color="#00B8D4EE" Offset="0.72"/>
                                    <GradientStop Color="#B8D4EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.463">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="260" Friction="30" SettleMs="463"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.463">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="260" Friction="30" SettleMs="463"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction><lg:SpringEase Tension="400" Friction="28" SettleMs="420"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dark slab (node board): drop shadow in the glow hue, double slab, rim lit on the glow-facing corner ===== -->
    <Style x:Key="LgGlowSlab" TargetType="ContentControl">
        <Setter Property="Padding" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource LgDarkInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <lg:SquircleBorder Radius="34" Background="#1C1C1C">
                            <lg:SquircleBorder.Effect>
                                <DropShadowEffect Color="#5FE070" Opacity="0.22" ShadowDepth="0" BlurRadius="38"/>
                            </lg:SquircleBorder.Effect>
                        </lg:SquircleBorder>
                        <lg:SquircleBorder Radius="34" BorderThickness="1.25" BorderBrush="{StaticResource LgDarkRimBrush}">
                            <lg:SquircleBorder.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E221F" Offset="0"/>
                                    <GradientStop Color="#1A2A1D" Offset="1"/>
                                </LinearGradientBrush>
                            </lg:SquircleBorder.Background>
                            <Grid>
                                <!-- inner slab inset one step, concentric radius -->
                                <lg:SquircleBorder Margin="9" Radius="25" BorderThickness="1" Background="#14FFFFFF">
                                    <lg:SquircleBorder.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                                            <GradientStop Color="#595FE070" Offset="1"/>
                                        </LinearGradientBrush>
                                    </lg:SquircleBorder.BorderBrush>
                                </lg:SquircleBorder>
                                <lg:GrainOverlay Opacity="0.4"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </lg:SquircleBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
